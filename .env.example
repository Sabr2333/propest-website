OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini

# HubSpot — Elara wachtlijst formulier
HUBSPOT_PRIVATE_APP_TOKEN=
HUBSPOT_ELARA_WAITLIST_SUBMIT_URL=

